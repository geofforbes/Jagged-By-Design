# Meta App Dashboard > WhatsApp > Configuration > Webhook > Verify token.
# Make up any string here, then enter the same value in that dashboard field.
WHATSAPP_VERIFY_TOKEN=

# Meta App Dashboard > WhatsApp > API Setup: temporary token for quick testing,
# or Business Settings > System Users: permanent token (recommended — the
# temporary one expires after 24h).
WHATSAPP_ACCESS_TOKEN=

# Meta App Dashboard > WhatsApp > API Setup > "From" phone number ID (the test
# number Meta gives you, not the number itself).
WHATSAPP_PHONE_NUMBER_ID=
