# Meta App Dashboard > WhatsApp > Configuration > Webhook > Verify token.
# Make up any string here, then enter the same value in that dashboard field.
WHATSAPP_VERIFY_TOKEN=

# Meta App Dashboard > WhatsApp > API Setup: temporary token for quick testing,
# or Business Settings > System Users: permanent token (recommended — the
# temporary one expires after 24h).
WHATSAPP_ACCESS_TOKEN=

# Meta App Dashboard > WhatsApp > API Setup > "From" phone number ID (the test
# number Meta gives you, not the number itself).
WHATSAPP_PHONE_NUMBER_ID=

# Vercel dashboard > Storage tab > Create Database > Postgres (Neon). Once
# connected to the project, Vercel injects this (or POSTGRES_URL) itself —
# you shouldn't need to set it by hand except for local dev (`vercel env pull`).
DATABASE_URL=

# console.anthropic.com > API Keys. Used for extracting structured events
# (visit, mood, observation, etc.) out of raw WhatsApp message text.
ANTHROPIC_API_KEY=

# platform.openai.com > API Keys. Used only by scripts/process-export.ts to
# transcribe WhatsApp voice notes (Claude doesn't take audio input). Local
# use only — not needed by any deployed Vercel function.
OPENAI_API_KEY=
